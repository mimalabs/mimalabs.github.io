# Canonical public URL.
# Local/default builds are prepared for the future production domain.
# GitHub Actions automatically overrides this with the real github.io URL
# until you connect mimalabsworld.com.
NEXT_PUBLIC_SITE_URL=https://mimalabsworld.com

# Leave empty for a root domain/user Pages site.
# For a GitHub project site the workflow automatically uses /<repository-name>.
NEXT_PUBLIC_BASE_PATH=

# Testimonials are automatically visible in local development and hidden in production.
# Set to true in production only after replacing demo reviews with genuine customer reviews.
NEXT_PUBLIC_TESTIMONIALS_ENABLED=false

# Paste the unique script URL Plausible gives you after adding the production domain.
# Example format: https://plausible.io/js/pa-XXXXX.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Optional Search Console ownership token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Ask before loading optional analytics by default.
NEXT_PUBLIC_COOKIE_CONSENT_REQUIRED=true
